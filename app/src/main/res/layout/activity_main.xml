<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QuestSongBridge"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0.0" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Status: STOPPED" />

        <TextView
            android:id="@+id/urlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="URL: -" />

        <TextView
            android:id="@+id/portText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Port: 8080" />

        <TextView
            android:id="@+id/tokenText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Token: -" />

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:contentDescription="QR code" />

        <TextView
            android:id="@+id/storageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Storage: not configured" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">
            <Button
                android:id="@+id/startBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Server" />
            <Button
                android:id="@+id/stopBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop Server" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Suggested: ModData/com.beatgames.beatsaber/Mods/SongCore/CustomLevels" />

        <Button
            android:id="@+id/selectStorageBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Destination Directory" />

        <Button
            android:id="@+id/testWriteBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Write" />

        <Button
            android:id="@+id/regenTokenBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Regenerate Token" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Settings"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/headsetNameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Headset name (QUESTXXXX)" />

        <EditText
            android:id="@+id/portEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Port (default 8080)"
            android:inputType="number" />

        <EditText
            android:id="@+id/maxUploadEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Max upload MB (default 200)"
            android:inputType="number" />

        <Spinner
            android:id="@+id/dupSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/retainZipCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retain uploaded ZIP after extraction" />

        <Button
            android:id="@+id/saveSettingsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Recent Activity"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp" />

        <Button
            android:id="@+id/clearLogBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Log" />

    </LinearLayout>
</ScrollView>
